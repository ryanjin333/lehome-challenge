[Unit]
Description=LeHome immutable experiment training worker
After=network-online.target docker.service
Wants=network-online.target
ConditionPathExists=/etc/lehome/experiment-bootstrap.ready
[Service]
Type=simple
User=lehome
EnvironmentFile=/etc/lehome/experiment-worker.env
LoadCredential=controller-token:/etc/lehome/private/controller-token
LoadCredential=hf-token:/etc/lehome/private/hf-token
Environment=LEHOME_CONTROLLER_TOKEN_FILE=%d/controller-token
Environment=HF_TOKEN_FILE=%d/hf-token
ExecStart=/usr/local/bin/lehome-experiment-worker
ExecStop=/usr/local/bin/lehome-experiment-worker --preempt
Restart=on-failure
RestartSec=15
TimeoutStopSec=55
KillMode=process
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/lehome /run/lehome
RuntimeDirectory=lehome
[Install]
WantedBy=multi-user.target
