[Unit]
Description=Record LeHome preemption shutdown hooks
DefaultDependencies=no
After=lehome-workspace.service
Before=lehome-training.service

[Service]
Type=oneshot
RemainAfterExit=yes
Group=ubuntu
RuntimeDirectory=lehome-rollout
RuntimeDirectoryMode=0770
ExecStart=/bin/true
ExecStop=/opt/lehome/guest/bin/lehome-preempt.sh
TimeoutStopSec=55
KillMode=none

[Install]
WantedBy=multi-user.target
