[Unit]
Description=Mount and admit the LeHome shared disk role lease
DefaultDependencies=no
After=local-fs.target cloud-init.service
Before=lehome-preempt.service
ConditionPathExists=/opt/lehome/guest/lehome_workspace.py

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/bin/bash -c 'for i in $(seq 1 90); do [ -s /etc/lehome/runtime.env ] && exit 0; sleep 1; done; echo "missing /etc/lehome/runtime.env" >&2; exit 1'
EnvironmentFile=-/etc/lehome/runtime.env
ExecStart=/opt/lehome/guest/bin/lehome-workspace.sh
TimeoutStartSec=120
Restart=no

[Install]
WantedBy=multi-user.target
