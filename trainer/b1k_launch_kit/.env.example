# Required before bootstrap. Accept the model gate first; the token must read the
# gated base models and write to the private model artifact repository.
HF_TOKEN=
MODEL_REPOSITORY=ryanjin333/lehome-groot-n17-models

# Training paths. Keep the human dataset only on training machines.
B1K_WORK_ROOT=/workspace/b1k
B1K_DATA_ROOT=/workspace/datasets/2026-challenge-demos
GROOT_DIR=/workspace/Isaac-GR00T
OUTPUT_ROOT=/workspace/outputs
LOG_DIR=/workspace/logs/b1k
HF_HOME=/workspace/.cache/huggingface

# Training defaults. Leave GPU_COUNT and BATCH_CANDIDATES unset to auto-detect:
# one GPU -> 256,128,64; two GPUs -> 512,256,128.
GPU_COUNT=
BATCH_CANDIDATES=
MAX_STEPS=15000
WANDB_MODE=offline
OMP_NUM_THREADS=8
ENABLE_CHECKPOINT_WATCHER=0

# Durable Hugging Face handoff.
CYCLE_ID=cycle-000
# Optional R2 configuration is used only for continuous checkpoint watching and
# by the current parent-cycle restore helper.
PARENT_CYCLE_ID=
R2_REMOTE=r2
R2_BUCKET=
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ACL=private

# Disposable-instance safety gate. Destruction occurs only after immutable
# Hugging Face upload/readback succeeds and the verified marker is written.
AUTO_DESTROY=1

# Only needed when using the stock Vast base image instead of the prebuilt image.
B1K_KIT_URL=
B1K_KIT_SHA256=
