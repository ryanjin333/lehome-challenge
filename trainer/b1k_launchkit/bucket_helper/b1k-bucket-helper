#!/usr/bin/env python3
"""One-request JSON helper running only inside the isolated Hub 1.24 venv."""
from __future__ import annotations
import json, os, re, sys
from pathlib import Path
import huggingface_hub as hub

BUCKET = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$")
SAFE_PATH = re.compile(r"^(?!/)(?!.*(?:^|/)\.\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$")
def pairs(items):
    out = {}
    for key, value in items:
        if key in out: raise ValueError("duplicate field")
        out[key] = value
    return out
def require_payload(payload, *, required, optional=()):
    if not isinstance(payload, dict) or not required <= set(payload) or not set(payload) <= required | set(optional): raise ValueError("invalid payload")
def safe_path(value):
    return type(value) is str and bool(SAFE_PATH.fullmatch(value)) and "*" not in value and "?" not in value
def main() -> None:
    try:
        request = json.loads(sys.stdin.read(), object_pairs_hook=pairs)
        if set(request) != {"version", "operation", "payload"} or request["version"] != 1: raise ValueError("invalid request")
        payload = request["payload"]; bucket_id = payload.get("bucket_id") if isinstance(payload, dict) else None
        if not isinstance(payload, dict) or not BUCKET.fullmatch(str(bucket_id)): raise ValueError("invalid bucket")
        if hub.__version__ != "1.24.0": raise ValueError("invalid helper runtime")
        token_path = os.environ.get("B1K_HF_TOKEN_FILE")
        expected = Path("/workspace/.cache/huggingface/token")
        if token_path:
            token_file = Path(token_path)
            stat = token_file.lstat()
            if token_file != expected or token_file.is_symlink() or not token_file.is_file() or stat.st_uid != os.getuid() or stat.st_mode & 0o777 != 0o600:
                raise ValueError("invalid token file")
            token = token_file.read_text().strip()
        else:
            token = os.environ.get("HF_TOKEN")
        if not token: raise ValueError("missing token")
        op = request["operation"]
        if op == "ensure":
            require_payload(payload, required={"bucket_id"}, optional={"create"})
            if "create" in payload and type(payload["create"]) is not bool: raise ValueError("invalid create")
            if payload.get("create") is True: hub.create_bucket(bucket_id, private=True, exist_ok=True, token=token)
            result = {"private": bool(hub.bucket_info(bucket_id, token=token).private)}
            if not result["private"]: raise ValueError("public bucket")
        elif op == "info":
            require_payload(payload, required={"bucket_id"})
            result = {"private": bool(hub.bucket_info(bucket_id, token=token).private)}
        elif op == "list":
            require_payload(payload, required={"bucket_id", "prefix"})
            if payload["prefix"] != "" and not safe_path(payload["prefix"]): raise ValueError("unsafe prefix")
            result = {"files": [{"path": item.path, "size": item.size, "xet_hash": item.xet_hash, "type": item.type} for item in hub.list_bucket_tree(bucket_id, prefix=payload.get("prefix"), recursive=True, token=token) if item.type == "file"]}
        elif op == "upload":
            require_payload(payload, required={"bucket_id", "local_path", "remote_path"})
            local, remote = Path(payload["local_path"]), payload["remote_path"]
            if not safe_path(remote) or local.is_symlink() or not local.is_file() or not local.resolve().is_relative_to(Path("/workspace/checkpoints")): raise ValueError("unsafe upload")
            hub.batch_bucket_files(bucket_id, add=[(str(local), remote)], token=token); result = {}
        elif op == "download":
            require_payload(payload, required={"bucket_id", "remote_path", "local_path"})
            remote, local = payload["remote_path"], Path(payload["local_path"])
            root = Path("/workspace/checkpoints")
            if not safe_path(remote) or local.is_symlink() or not local.resolve().parent.is_relative_to(root): raise ValueError("unsafe download")
            local.parent.mkdir(parents=True, exist_ok=True)
            hub.download_bucket_files(bucket_id, files=[(remote, str(local))], raise_on_missing_files=True, token=token); result = {}
        elif op == "copy":
            require_payload(payload, required={"bucket_id", "source", "destination"})
            if not safe_path(payload["source"]) or not safe_path(payload["destination"]): raise ValueError("unsafe copy")
            source = f"hf://buckets/{bucket_id}/{payload['source']}"
            destination = f"hf://buckets/{bucket_id}/{payload['destination']}"
            hub.copy_files(source, destination, token=token); result = {}
        elif op == "delete":
            require_payload(payload, required={"bucket_id", "paths"})
            paths = payload["paths"]
            if not isinstance(paths, list) or not paths or not all(safe_path(path) for path in paths): raise ValueError("unsafe delete")
            hub.batch_bucket_files(bucket_id, delete=paths, token=token); result = {}
        else: raise ValueError("unsupported operation")
        sys.stdout.write(json.dumps({"ok": True, "result": result}, separators=(",", ":")) + "\n")
    except Exception as error:
        response = getattr(error, "response", None)
        status = getattr(response, "status_code", None)
        sys.stdout.write('{"ok":false,"error":"not_found"}\n' if status == 404 else '{"ok":false,"error":"operation_failed"}\n')
        raise SystemExit(1)
if __name__ == "__main__": main()
